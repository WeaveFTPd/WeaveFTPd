debug: false
log_file:      "logs/sitebot.log"
log_delete_after_days: 1
log_keep_days: 1
log_console:   true

event_fifo: "/WeaveFTPd/etc/weaveftpd.sitebot.fifo"

# Channel sets are YAML anchors. The sitebot ignores this top-level block, but
# YAML expands the anchors anywhere they are referenced below.
channel_sets:
  main:    &chan_main    ["#weaveftpd"]
  chat:    &chan_chat    ["#weaveftpd-chat"]
  spam:    &chan_spam    ["#weaveftpd-spam"]
  staff:   &chan_staff   ["#weaveftpd-staff"]
  foreign: &chan_foreign ["#weaveftpd-foreign"]
  archive: &chan_archive ["#weaveftpd-archive"]
  nuke:    &chan_nuke    ["#weaveftpd-nuke"]

irc:
  host: "irc.example.net"
  port: 6697
  nick: "GoSitebot"
  user: "sitebot"
  # Version comes from a plain "version" file:
  #   1. sitebot/etc/version
  #   2. nearest ancestor etc/version (default integrated layout)
  realname: "GoSitebot"
  password: "changeme"
  ssl: true
  # Server-certificate verification for the IRC connection (only relevant
  # when ssl: true):
  #   strict   - verify against the system trust store (default; use this
  #              for public IRC networks with globally-trusted certs)
  #   custom   - verify against tls_ca_cert below (self-hosted/private IRCd)
  #   insecure - keep TLS encryption but accept any server certificate;
  #              explicit compatibility fallback only (not recommended)
  tls_verify: "strict"
  tls_ca_cert: ""   # required when tls_verify: custom, e.g. "./etc/certs/irc-ca.crt"
  nickserv:
    enabled: false
    service: "NickServ"
    account: ""
    password: "changeme-nickserv"
    email: "sitebot@example.net"
    auto_register: false
    delay_ms: 800
  auto_oper: false
  operuser: "GoSitebot"
  operpassword: "changeme-oper"
  user_modes: "+Hi"
  # Applied after joining configured channels and when the bot receives ops.
  # Supports +i (invite-only), +s (secret), or +is. Empty leaves modes unchanged.
  # Requires channel ops, or auto_oper with permission to use SAMODE.
  channel_modes: ""
  autojoin_delay_ms: 250
  channels:
    - "#weaveftpd"
    - "#weaveftpd-chat"
    - "#weaveftpd-spam"
    - "#weaveftpd-staff"
    - "#weaveftpd-foreign"
    - "#weaveftpd-archive"
    - "#weaveftpd-nuke"

# ============================================================================
# SITE INVITE channel visibility
# ============================================================================
# Channels listed here are restricted to users with at least one of the given
# flags. Any channel NOT listed is considered public and returned to everyone.
# Flags are matched character-by-character: "12" means flag 1 OR flag 2.
# ============================================================================
invite_channels:
  - channel: "#weaveftpd-staff"
    flags: "1"

encryption:
  enabled: true
  # Auto-exchange FiSH keys for PM/NOTICE traffic with users via DH1080.
  # This is peer-to-peer only; channel/topic FiSH still uses the static keys
  # below because DH1080 does not negotiate a shared channel key.
  # If this setting is omitted, the sitebot defaults it to true.
  auto_exchange: true
  # Plain keys default to CBC.
  # You can also force the mode explicitly with:
  #   cbc:<key>
  # setup.sh may still write the cbc: prefix for clarity.
  # private_key is used for PM/NOTICE replies to users and for decrypting
  # incoming encrypted PM commands sent directly to the bot nick.
  # Leave this empty if you want to rely on DH1080 auto-exchange instead.
  private_key: "cbc:YourBlowfishKeyHere123456"
  keys:
    "#weaveftpd": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-chat": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-spam": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-staff": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-foreign": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-archive": "cbc:YourBlowfishKeyHere123456"
    "#weaveftpd-nuke": "cbc:YourBlowfishKeyHere123456"

announce:
  config_file: "plugins/announce/config.yml"
  # To use the bundled DrFTPD-like announce preset, set in
  # plugins/announce/config.yml:
  #   theme_file: "./etc/templates/drftpd.theme"
  # Pretime inline/newline mode lives in plugins/announce/config.yml:
  #   pretime:
  #     mode: "inline"
  # External scripts can also write JSON-line CUSTOM events directly to
  # event_fifo. Give them an announce_type like SPACEARCHIVE / SPACEOFFSITE /
  # SPACEDELETE and route those in plugins/announce/config.yml:
  #   type_routes:
  #     SPACEARCHIVE: ["#weaveftpd-archive"]
  #     SPACEOFFSITE: ["#weaveftpd-archive"]
  #     SPACEDELETE: ["#weaveftpd-archive"]

help:
  channels: *chan_chat
  reply_target: "pm"
  lines:
    - "!help - show this help in PM"
    - "!rules - show site rules in PM"
    - "!top [5|10|25] - show daily top uploaders"
    - "!request <release> - add a request"
    - "!requests - list requests"
    - "!ip - PM help for self-service IP commands"

sections:
  - name: "DEFAULT"
    channels: *chan_staff
    paths: []

#########################
# #weaveftpd-chat
#########################

  - name: "REQUESTS"
    channels: *chan_chat
    paths:
      - "/REQUESTS/*/*"

  - name: "SPEEDTEST"
    channels: *chan_chat
    paths:
      - "/SPEEDTEST/*"

#########################
# #weaveftpd-foreign
#########################

  - name: "TV-CZ"
    channels: *chan_foreign
    paths:
      - "/FOREIGN/TV-CZ/*"

  - name: "TV-DE"
    channels: *chan_foreign
    paths:
      - "/FOREIGN/TV-DE/*"

  - name: "TV-DK"
    channels: *chan_foreign
    paths:
      - "/FOREIGN/TV-DK/*"

  - name: "TV-ES"
    channels: *chan_foreign
    paths:
      - "/FOREIGN/TV-ES/*"

  - name: "TV-FI"
    channels: *chan_foreign
    paths:
      - "/FOREIGN/TV-FI/*"

  - name: "TV-FR"
    channels: *chan_foreign
