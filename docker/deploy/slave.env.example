# Image name. Use the same tag as the master.
WEAVEFTPD_IMAGE=ghcr.io/weaveftpd/weaveftpd:latest

# Runtime directory created by ./init.sh slave.
WEAVEFTPD_SLAVE_RUNTIME=./runtime/slave

# Host path that becomes /app/site in the slave container.
WEAVEFTPD_SLAVE_SITE_PATH=./runtime/slave/site

WEAVEFTPD_UID=0
WEAVEFTPD_GID=0
